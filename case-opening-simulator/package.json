{
  "name": "case-opening-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "npm run assets:verify",
    "dev": "vite",
    "build": "npm run assets:verify && tsc -b && vite build",
    "build:github": "npm run assets:verify && tsc -b && vite build --base=/case-opening-simulator/",
    "deploy": "npm run build:github && gh-pages -d dist",
    "import:cs2-assets": "ts-node --esm ./scripts/importCs2Assets.ts",
    "assets:sync": "node scripts/syncCs2Assets.mjs",
    "assets:verify": "node scripts/syncCs2Assets.mjs --verify",
    "update:skin-prices": "ts-node --esm ./scripts/updateSkinPricesFromCsgoskins.ts",
    "generate:pattern-lookups": "node scripts/generatePatternLookup.mjs",
    "lint": "eslint .",
    "preview:prod": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "verify:pwa": "node scripts/verifyReleaseBuild.mjs",
    "verify:release": "npm run lint && npm run test && npm run build && npm run verify:pwa",
    "verify:ci": "npm run typecheck && npm run verify:release && npm run test:e2e"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide-react": "^1.21.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.2.7",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "csgo-blue-gem-calculator": "^0.0.3",
    "csgo-fade-percentage-calculator": "^2.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
