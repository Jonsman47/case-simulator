# Optional Supabase browser configuration. The anon/publishable key is safe for a public client
# only when the included RLS policies are applied. Never put a service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional deployment base, for example /case-simulator/ on GitHub Pages.
VITE_BASE_PATH=/
